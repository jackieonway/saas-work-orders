# Copy the values into the ignored root .env.docker or an external secret store.
# Never publish this file with real credentials in microapp static builds.

# Required by --profile work-orders. The production service requires HTTPS.
WORK_ORDERS_PLATFORM_API_ORIGIN=https://saas.example.com
# Use the actual generated ID of the linked CONFIDENTIAL OAuth client.
WORK_ORDERS_PLATFORM_CLIENT_ID=REPLACE_WITH_CREATED_CLIENT_ID
WORK_ORDERS_PLATFORM_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
WORK_ORDERS_PLATFORM_AUTH_TIMEOUT_MS=3000
# Opaque iframe requests carry the literal Origin:null and a short app Bearer.
# The business API does not use credentialed CORS or browser cookies.
WORK_ORDERS_ALLOWED_ORIGINS=null

# Independent business database. Do not use the platform database URL.
# With --profile work-orders-local-db, the host is work-orders-postgres.
# A password used in a URL must be percent-encoded as necessary.
WORK_ORDERS_DATABASE_URL=postgresql://work_orders:REPLACE_DATABASE_PASSWORD@work-orders-postgres:5432/work_orders
WORK_ORDERS_POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD

# Existing root deployment settings; configure the actual HTTPS/TLS ingress.
PUBLIC_APP_URL=https://saas.example.com
APPLICATION_ENVIRONMENT=production
MICRO_GATEWAY_ORIGIN=https://saas.example.com
MICRO_ALLOWED_ORIGINS=https://saas.example.com
NOTIFICATION_ALLOWED_ORIGINS=https://saas.example.com
MICRO_APPS_DIR=./deploy/micro-apps
