# Inject values through your deployment environment; Rust does not auto-load this file.
# Use a dedicated business database and account, never the platform DATABASE_URL.
WORK_ORDERS_DATABASE_URL=postgresql://work_orders:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/work_orders
WORK_ORDERS_HOST=0.0.0.0
WORK_ORDERS_PORT=3004
WORK_ORDERS_DB_MAX_CONNECTIONS=10
WORK_ORDERS_DB_ACQUIRE_TIMEOUT_MS=5000
WORK_ORDERS_DB_STATEMENT_TIMEOUT_MS=5000
WORK_ORDERS_DB_LOCK_TIMEOUT_MS=5000
WORK_ORDERS_STARTUP_TIMEOUT_MS=30000
WORK_ORDERS_SHUTDOWN_TIMEOUT_MS=10000
WORK_ORDERS_HEALTH_TIMEOUT_MS=2000
# NODE_ENV=production requires a nonzero port and exact HTTPS origins; no Node runtime is needed.
# Configure PostgreSQL TLS explicitly when required, e.g. sslmode=verify-full&sslrootcert=...

# Required by the actual Rust run/application; the application code is fixed to work-orders.
# Use the platform-generated confidential client ID, not its display name.
PLATFORM_API_ORIGIN=https://saas.example.com
PLATFORM_CLIENT_ID=REPLACE_WITH_PLATFORM_GENERATED_CLIENT_ID
PLATFORM_CLIENT_SECRET=REPLACE_WITH_PRIVATE_CLIENT_SECRET
# Combined introspection + context + response-reading budget in milliseconds: 100..10000.
PLATFORM_AUTH_TIMEOUT_MS=3000
# Per-process authorization permits: 1..128; saturation returns 503 immediately, without queuing.
PLATFORM_AUTH_MAX_CONCURRENT=32
PLATFORM_AUTHORIZATION_MODE=combined
# Each upstream JSON response is capped at 256 KiB. Redirects and ambient proxies are disabled.
# Optional PEM bundle, at most 1 MiB; appends trusted roots without disabling TLS validation.
# PLATFORM_CA_CERT_FILE=/run/secrets/platform-ca.pem
# Exact comma-separated origins, or literal null for opaque iframe; never use a wildcard.
WORK_ORDERS_ALLOWED_ORIGINS=null
