# Independent business database and least-privilege business database role.
# Do not point this at the platform database; no platform tables or JWT key are used.
WORK_ORDERS_DATABASE_URL=postgresql://work_orders_user:REPLACE_ME@business-db:5432/work_orders
NODE_ENV=production
WORK_ORDERS_HOST=0.0.0.0
WORK_ORDERS_PORT=3004

# Exact HTTPS origin, without path, trailing slash or embedded credentials.
# Local development permits http://127.0.0.1:3001 or http://[::1]:3001.
PLATFORM_API_ORIGIN=https://platform.example.com
PLATFORM_CLIENT_ID=work-orders-client
PLATFORM_CLIENT_SECRET=REPLACE_ME
PLATFORM_AUTH_TIMEOUT_MS=3000

# Literal null is required for the existing opaque sandbox iframe.
# CORS has no credentials; every protected operation requires an app token and live authorization.
WORK_ORDERS_ALLOWED_ORIGINS=null
